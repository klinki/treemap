<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Treemap.Host.WinForms</RootNamespace>
    <AssemblyName>TreemapHost</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Treemap.Core\Treemap.Core.csproj" />
    <ProjectReference Include="..\Treemap.Skia\Treemap.Skia.csproj" />
  </ItemGroup>
</Project>
